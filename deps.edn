{:paths ["src"]
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       kotoba-lang/faceid {:git/url "https://github.com/kotoba-lang/faceid.git"
                                     :git/sha "6dc28282e6c24816e33c5e7d99907fdd54da90d3"}
        kotoba-lang/touchid {:git/url "https://github.com/kotoba-lang/touchid.git"
                                     :git/sha "26a28b949bab1d3d001119da88a78730ac447610"}
        io.github.kotoba-lang/webauthn {:git/sha "4f8a5976086ea1d4ee88805a5cae6a384b730811"}
        kotoba-lang/onetime {:git/url "https://github.com/kotoba-lang/onetime.git"
                                     :git/sha "fc0c2f0bc57f2b05d3dd6b2f0730dafbb77e9364"}
        io.github.kotoba-lang/oauth {:git/sha "e47999a48cbc79e831c0690bac6681bda0b52785"}
        ;; Advanced 2d3ca2b -> a10ef87 (a fast-forward, verified with
        ;; `git merge-base --is-ancestor`). At 2d3ca2b oidc named the identity
        ;; repository by the bare group `kotoba-lang/identity`; every consumer
        ;; that also reached it as `io.github.kotoba-lang/identity` therefore
        ;; put identity.* on the classpath twice, from two revisions.
        kotoba-lang/oidc {:git/url "https://github.com/kotoba-lang/oidc.git"
                                     :git/sha "a10ef875542c79ae5937647489963efb80bfad18"}
        kotoba-lang/saml {:git/url "https://github.com/kotoba-lang/saml.git"
                                     :git/sha "8b0b4d7e1f63aa9d5537e07f532ddc0c60759040"}
        ;; real did:key CACAO verification (ADR-2607050400) -- a real,
        ;; independently-pushed repo (unlike the :local/root siblings above).
        ;; Renamed cacao -> org-chainagnostic-cacao (ADR-2607061650); the ns
        ;; names (cacao.core, cacao.edge.*) did not change. :git/url is spelled
        ;; out rather than derived from the coordinate so resolution does not
        ;; depend on GitHub's rename redirect still being served.
        ;;
        ;; Pinned past BOTH (a) cacao.core/verify's :now expiry-check fix,
        ;; without which production-cacao-verifier's clock injection has no
        ;; effect, and (b) cacao.edge.{verify,mint} -- the WebCrypto edge
        ;; verifier/minter authentication.adapters.cacao-edge needs, which did
        ;; not exist at the previous pin (63e9db1).
        io.github.kotoba-lang/org-chainagnostic-cacao
        {:git/url "https://github.com/kotoba-lang/org-chainagnostic-cacao.git"
         ;; Adds the strict EIP-4361 parser plus the edge EIP-191/
         ;; secp256k1 verifier used by authentication.adapters.siwe-edge.
         ;; This is a fast-forward from dac9405 and keeps CACAO + SIWE on one
         ;; coordinate rather than resolving two revisions of the same repo.
         :git/sha "2f74d258fdbc94b8f7558843e69426c9b2e6cd97"}
        ;; The decision ledger: langchain.db is the index and the Datalog
        ;; engine, journal is the append-only history, langchain.persist is
        ;; the seam. Both are real, independently-pushed repos, so they are
        ;; git deps rather than :local/root siblings -- CI needs no extra
        ;; checkout step for them.
        ;;
        ;; langchain is pinned at schema-from-tx-data, which authentication.schema
        ;; needs to express one canonical schema in both dialects.
        io.github.kotoba-lang/langchain
        {:git/sha "8789fe4cc387f294b6936f2171e419a252fd9ea8"}
        io.github.kotoba-lang/journal
        {:git/sha "4ee86a07c162cf46707232fa70a720f989989486"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]
                  :exec-fn cognitect.test-runner.api/test}}}
